# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# --- CalorieGenius ---
# Secrets: .env holds the Anthropic + USDA keys. .env.example is committed.
.env
.env*.local
!.env.example

# Prisma's generated client — regenerated by `npm run db:generate`.
/src/generated/

# Local dumps, backups, and any food photos that get written to disk.
/data/
*.db
*.db-journal

# Prisma's `init` installs agent skill docs for several editors. Keep the Claude
# ones (this project is developed with Claude Code); the others are noise.
/.windsurf/
/.agents/
