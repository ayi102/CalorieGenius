# Local pilot configuration. NEVER commit this file.
# Postgres role is your macOS username; Homebrew's initdb creates it passwordless.
DATABASE_URL="postgresql://USER@localhost:5432/caloriegenius"

# Auth provider: dev (seeded local users) | supabase (real JWT verification)
AUTH_MODE="dev"

# --- Food parsing ---
PARSER_PROVIDER="anthropic"
# Personal account key from platform.claude.com. Paste it here; never into chat.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Per-user, per-day parse cap. A circuit breaker, not a business rule.
DAILY_PARSE_LIMIT="30"

# --- Nutrition grounding ---
# Free key: https://api.data.gov/signup
USDA_FDC_API_KEY=""
# Open Food Facts REQUIRES a contact email in the User-Agent on every request,
# so this string leaves your machine. Use a personal address, not a work one.
OFF_USER_AGENT="CalorieGenius/1.0 (your-personal@email.com)"

# --- Deploy only (AUTH_MODE=supabase) -------------------------------------
# From the Supabase dashboard: Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
#
# Connection strings: Project Settings -> Database.
# DATABASE_URL must be the POOLED connection (port 6543) — it is what the app
# uses at runtime on serverless. MIGRATION_DATABASE_URL must be the DIRECT
# connection (port 5432); `prisma migrate` needs a real session and will HANG on
# the pooled URL.
# MIGRATION_DATABASE_URL="postgresql://...:5432/postgres"
